generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password_hash String
  role          String   @default("participant") // participant, mentor, judge, organizer, sponsor
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile       Profile?
  notifications Notification[]
  joinRequests  JoinRequest[]
}

model Notification {
  id        String   @id @default(uuid())
  user_id   String
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  type      String   // e.g., submission_created, evaluation_completed, etc.
  title     String
  message   String
  is_read   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Profile {
  id                String    @id @default(uuid())
  user_id           String    @unique
  user              User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  avatar_url        String    @default("")
  skills            String    @default("[]") // JSON string array
  experience_level  String    @default("Intermediate")
  interests         String    @default("[]") // JSON string array
  timezone          String    @default("UTC")
  project_goal_text String    @default("")
  last_check_in_at  DateTime?
  check_in_count    Int       @default(0)
  check_in_streak   Int       @default(0)
  badges            String    @default("[]") // JSON string array
  preferred_language String   @default("en")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Team {
  id                   String            @id @default(uuid())
  name                 String
  leader_id            String?
  description          String            @default("")
  logo_url             String            @default("")
  category             String            @default("General")
  max_members          Int               @default(4)
  required_skills      String            @default("[]") // JSON string array
  tech_stack           String            @default("[]") // JSON string array
  member_ids           String            @default("[]") // JSON string array of user IDs
  match_rationale_text String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  submissions          Submission[]
  engagementEvents     EngagementEvent[]
  mentorMessages       MentorMessage[]
  joinRequests         JoinRequest[]
}

model JoinRequest {
  id        String   @id @default(uuid())
  team_id   String
  team      Team     @relation(fields: [team_id], references: [id], onDelete: Cascade)
  user_id   String
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  status    String   @default("pending") // pending, accepted, rejected, cancelled
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Submission {
  id              String       @id @default(uuid())
  team_id         String
  team            Team         @relation(fields: [team_id], references: [id], onDelete: Cascade)
  repo_link       String
  description     String
  demo_video_link String?
  status          String       @default("SUBMITTED") // DRAFT, SUBMITTED
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  evaluations     Evaluation[]
}

model Evaluation {
  id                    String     @id @default(uuid())
  submission_id         String
  submission            Submission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  originality_score     Float
  technical_depth_score Float
  completeness_score    Float
  clarity_score         Float
  ai_justification_text String
  judge_manual_score    Float?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
}

model EngagementEvent {
  id        String   @id @default(uuid())
  team_id   String
  team      Team     @relation(fields: [team_id], references: [id], onDelete: Cascade)
  user_id   String?
  event_type String   // check_in, chat_message, submission_create, submission_update
  timestamp DateTime @default(now())
}

model MentorMessage {
  id        String   @id @default(uuid())
  team_id   String
  team      Team     @relation(fields: [team_id], references: [id], onDelete: Cascade)
  sender    String   // user, mentor
  content   String
  timestamp DateTime @default(now())
}
